# Copia este archivo como .env y ajusta los valores. .env está en .gitignore: nunca lo subas.
# docker compose lee .env automáticamente desde la raíz del repositorio.

# --- Administrador inicial (obligatorio) ---------------------------------------------------
# Sin esta variable Compose no arranca: sin administrador nadie puede incorporar vendedores.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@nexusmarket.local
SEED_ADMIN_ID=admin-001
SEED_ADMIN_DOCUMENT=ADMIN-0001

# --- Seguridad --------------------------------------------------------------------------------
# Mínimo 32 caracteres (HS256). El valor por defecto de Compose es solo para desarrollo.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Orígenes del frontend, separados por comas. Nunca uses un comodín.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MySQL ------------------------------------------------------------------------------------
MYSQL_DATABASE=nexusmarket
MYSQL_USER=nexusmarket
MYSQL_PASSWORD=nexusmarket
MYSQL_ROOT_PASSWORD=root_password
# Solo para apuntar la app a una base gestionada; con Compose deja los valores por defecto.
# MYSQL_HOST=mysql-db
# MYSQL_PORT=3306

# --- MongoDB (bitácora de operaciones) --------------------------------------------------------
MONGO_DATABASE=nexusmarket_logs
# MONGO_HOST=mongo-db
# MONGO_PORT=27017

# --- Esquema ----------------------------------------------------------------------------------
# update crea y ajusta las tablas; en producción considera validate.
JPA_DDL_AUTO=update

# --- Puertos publicados en el host ------------------------------------------------------------
HOST_SERVER_PORT=8080
HOST_MYSQL_PORT=3306
HOST_MONGO_PORT=27017
